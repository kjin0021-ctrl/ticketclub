# Optional: free Amadeus Self-Service test credentials.
# Create an app at https://developers.amadeus.com/ and keep these server-side.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Public repository used to sync structured TicketClub alert Issues into the
# browser confirmation inbox. Forks should replace this value.
NEXT_PUBLIC_GITHUB_REPOSITORY=kjin0021-ctrl/ticketclub

# Scheduled email notifications are configured as GitHub Actions Secrets,
# not in this local file: SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER,
# SMTP_PASS, SMTP_FROM (optional), and NOTIFY_EMAIL.
